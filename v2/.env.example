# Supabase -> Project Settings -> Database -> Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ความลับสำหรับเซ็นคุกกี้ session (สร้างใหม่ด้วย: node -e "console.log(require(0+'crypto').randomBytes(48).toString(0+'base64url'))")
SESSION_SECRET=

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://iixrwaxauzuzibgdlvjq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ใช้ครั้งเดียวตอนย้ายข้อมูลจากระบบเดิม (ดู scripts/migrate-from-sheets.ts)
LEGACY_EXEC_URL=
LEGACY_ADMIN_USERNAME=
LEGACY_ADMIN_PASSWORD=

# คัดลอกด้วยมือจาก Apps Script เดิม: Project Settings -> Script Properties -> PASSWORD_PEPPER
# จำเป็นเพื่อให้ผู้ใช้ที่ย้ายมาล็อกอินด้วยรหัสเดิมได้ (ระบบจะอัปเกรดเป็น scrypt ให้เองหลังล็อกอินครั้งแรก)
LEGACY_PASSWORD_PEPPER=

# คีย์ให้โปรแกรม Python เรียก /api/worker (สร้างใหม่ด้วย openssl rand -base64 36)
WORKER_API_KEY=

# Google Drive OCR สำหรับอ่าน Slip ธนาคารในหน้าจัดการแลก DO (ฟรี ไม่ต้องเปิด billing)
# ต้องมี OAuth client แบบ Desktop app + เปิดใช้ Google Drive API ในโปรเจกต์เดียวกัน
# ขอค่าได้ด้วย: npx tsx scripts/google-oauth.mts <CLIENT_ID> <CLIENT_SECRET>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
